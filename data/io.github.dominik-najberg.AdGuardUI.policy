<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<!--
  Privileged actions for AdGuard UI.

  AdGuard CLI itself ships no polkit policy and its adguard_root_helper is not
  setuid, so there is nothing to reuse — this policy and its helper are ours.

  Security requirements for the helper (see docs/architecture.md section 6):
    * an enumerated, closed set of actions; no free-form arguments or paths
    * the target user's UID and data directory passed explicitly, never taken
      from the ambient environment — AdGuard's config lives under ~/.local,
      so a root helper that trusts $HOME is a privilege-escalation bug
    * it delegates to `adguard-cli`; it does not reimplement AdGuard logic

  NOTE: adguard-ui-helper is not implemented yet. This file is scaffolding for
  the auto-mode work; installing it now grants nothing, because the referenced
  binary does not exist.
-->
<policyconfig>

  <vendor>AdGuard UI</vendor>
  <vendor_url>https://github.com/dominik-najberg/AdGuard-UI-Linux</vendor_url>

  <action id="io.github.dominik-najberg.AdGuardUI.set-proxy-mode">
    <description>Change AdGuard filtering mode</description>
    <message>Authentication is required to change system-wide filtering</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/adguard-ui-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="io.github.dominik-najberg.AdGuardUI.set-system-dns">
    <description>Change system-wide DNS filtering</description>
    <message>Authentication is required to change system-wide DNS filtering</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/adguard-ui-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="io.github.dominik-najberg.AdGuardUI.install-system-certificate">
    <description>Install the AdGuard HTTPS filtering certificate</description>
    <message>Authentication is required to install the AdGuard certificate into the system trust store</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/adguard-ui-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
